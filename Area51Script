local packPunchRunning = false

createButton(weaponsContainer, "PackPunch", "TP", function()
    if packPunchRunning then return end
    local displayerLabel = getDisplayerTextlabel()
    if displayerLabel and displayerLabel.Text ~= "" and displayerLabel.Text ~= "nil" then
        showPaPWarning()
        return
    end
    local character = LocalPlayer.Character
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end
    packPunchRunning = true
    task.spawn(function()
        local pos1 = Vector3.new(111, 313, 69)
        local pos2 = Vector3.new(111, 316, 42)
        local initialLook = rootPart.CFrame.LookVector
        rootPart.Anchored = true
        rootPart.CFrame = CFrame.new(pos1, pos1 + Vector3.new(initialLook.X, 0, initialLook.Z))
        local startTime = os.clock()
        while (os.clock() - startTime) < 0.5 do
            local prompt = getSpecificTeleportPrompt()
            if prompt then
                triggerPrompt(prompt)
            end
            task.wait(0.05)
        end
        local smoothStart = os.clock()
        local startCFrame = rootPart.CFrame
        local targetCFrame = CFrame.new(pos2, pos2 + Vector3.new(initialLook.X, 0, initialLook.Z))
        while (os.clock() - smoothStart) < 0.2 do
            if rootPart and rootPart.Parent then
                local alpha = math.clamp((os.clock() - smoothStart) / 0.2, 0, 1)
                rootPart.CFrame = startCFrame:Lerp(targetCFrame, alpha)
            end
            RunService.Heartbeat:Wait()
        end
        if rootPart and rootPart.Parent then
            rootPart.CFrame = targetCFrame
            rootPart.Velocity = Vector3.zero
            rootPart.AssemblyLinearVelocity = Vector3.zero
            rootPart.Anchored = false
        end
        packPunchRunning = false
    end)
end)

