local function triggerPrompt(prompt)
    if not prompt or not prompt:IsA("ProximityPrompt") then return end
    if fireproximityprompt then
        fireproximityprompt(prompt)
    else
        prompt.MaxActivationDistance = math.huge
        prompt:InputHoldBegin()
        task.wait(prompt.HoldDuration + 0.05)
        prompt:InputHoldEnd()
    end
end

local function getSpecificTeleportPrompt()
    local area51 = Workspace:FindFirstChild("AREA51")
    local teleporterRoom = area51 and area51:FindFirstChild("TeleporterRoom")
    local teleporter = teleporterRoom and teleporterRoom:FindFirstChild("Teleporter")
    local controlPanels = teleporter and teleporter:FindFirstChild("Control Panels")
    local middle = controlPanels and controlPanels:FindFirstChild("Middle")
    local teleportPart = middle and middle:FindFirstChild("Teleport")
    if teleportPart then
        return teleportPart:FindFirstChildWhichIsA("ProximityPrompt", true)
    end
    return nil
end

local function getDisplayerTextlabel()
    local area51 = Workspace:FindFirstChild("AREA51")
    local teleporterRoom = area51 and area51:FindFirstChild("TeleporterRoom")
    local teleporter = teleporterRoom and teleporterRoom:FindFirstChild("Teleporter")
    local controlPanels = teleporter and teleporter:FindFirstChild("Control Panels")
    local middle = controlPanels and controlPanels:FindFirstChild("Middle")
    local displayer = middle and middle:FindFirstChild("Displayer")
    if displayer then
        for _, child in ipairs(displayer:GetDescendants()) do
            if child:IsA("TextLabel") then
                return child
            end
        end
    end
    return nil
end

