                local hitbox = weaponModel:FindFirstChild("Hitbox")
                if hitbox and hitbox:IsA("BasePart") then
                    table.insert(weaponData, { name = weaponModel.Name, hitbox = hitbox })
                end
            end
        end
        if #weaponData > 0 then
            local startTime = os.clock()
            local totalDuration = 0.2
            local count = #weaponData
            for i, data in ipairs(weaponData) do
                if rootPart and rootPart.Parent and data.hitbox.Parent then
                    rootPart.CFrame = data.hitbox.CFrame + Vector3.new(0, 2, 0)
                    humanoid.Sit = true
