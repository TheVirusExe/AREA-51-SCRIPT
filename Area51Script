local function getNpcPart(npc)
    return npc:FindFirstChild("Head")
        or npc:FindFirstChild("HumanoidRootPart")
        or npc:FindFirstChild("UpperTorso")
        or npc:FindFirstChild("Torso")
        or npc:FindFirstChildWhichIsA("BasePart")
end

local function destroyEsp(npc)
    local entry = espCache[npc]
    if entry then
        if entry.highlight then entry.highlight:Destroy() end
        if entry.billboard then entry.billboard:Destroy() end
        espCache[npc] = nil
    end
end

local function ensureEsp(npc, enabled)
    local entry = espCache[npc]
    if not entry then
        entry = {}
        espCache[npc] = entry
    end

    if not entry.highlight or not entry.highlight.Parent then
        if entry.highlight then entry.highlight:Destroy() end
        local hl = Instance.new("Highlight")
        hl.FillColor = Color3.fromRGB(255, 0, 0)
        hl.FillTransparency = 0.5
        hl.OutlineColor = Color3.fromRGB(255, 255, 255)
        hl.OutlineTransparency = 0
        hl.Parent = CoreGui
        entry.highlight = hl
    end
    entry.highlight.Adornee = npc
    entry.highlight.Enabled = enabled

    if not entry.billboard or not entry.billboard.Parent then
        if entry.billboard then entry.billboard:Destroy() end
        local bb = Instance.new("BillboardGui")
        bb.Size = UDim2.new(0, 100, 0, 40)
        bb.StudsOffset = Vector3.new(0, 3.5, 0)
        bb.AlwaysOnTop = true
        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(1, 0, 1, 0)
        lbl.BackgroundTransparency = 1
        lbl.Text = npc.Name
        lbl.TextColor3 = Color3.fromRGB(255, 0, 0)
        lbl.TextStrokeTransparency = 0
        lbl.Font = Enum.Font.Code
        lbl.TextSize = 12
        lbl.Parent = bb
        entry.billboard = bb
    end

    local head = npc:FindFirstChild("Head") or getNpcPart(npc)
    if head then
        if entry.billboard.Parent ~= head then
            entry.billboard.Adornee = head
            entry.billboard.Parent = head
        end
    else
        if entry.billboard.Parent ~= npc then
            entry.billboard.Adornee = npc
            entry.billboard.Parent = npc
        end
    end
    entry.billboard.Enabled = enabled

    return entry
end

local function hideAllEsp()
    for _, entry in pairs(espCache) do
        if entry.highlight then entry.highlight.Enabled = false end
        if entry.billboard then entry.billboard.Enabled = false end
    end
end

local function clearAllEsp()
    for npc in pairs(espCache) do
        destroyEsp(npc)
    end
end

local function createTracer()
    if tracerMode == "drawing" then
        local line = Drawing.new("Line")
        line.Color = Color3.fromRGB(255, 0, 0)
        line.Thickness = 2
        line.Transparency = 1
        line.Visible = false
        return {
            update = function(from, to, visible)
                line.From = from
                line.To = to
                line.Visible = visible
            end,
            remove = function()
                pcall(function()
                    line.Visible = false
                    line:Remove()
                end)
            end
        }
    end
    local frame = Instance.new("Frame")
    frame.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
    frame.BackgroundTransparency = 0
    frame.BorderSizePixel = 0
    frame.Visible = false
    frame.ZIndex = 1
    frame.Parent = TracerGui
    return {
        update = function(from, to, visible)
            if not visible then
                frame.Visible = false
                return
            end
            local delta = to - from
            local length = delta.Magnitude
            if length < 1 then
                frame.Visible = false
                return
            end
            local mid = (from + to) * 0.5
            local angle = math.deg(math.atan2(delta.Y, delta.X))
            frame.Position = UDim2.new(0, mid.X - length / 2, 0, mid.Y - 1)
            frame.Size = UDim2.new(0, length, 0, 2)
            frame.Rotation = angle
            frame.Visible = true
        end,
        remove = function()
            frame:Destroy()
        end
    }
end

local function ensureTracer(npc)
    local tracer = tracerCache[npc]
    if tracer then return tracer end
    tracer = createTracer()
    tracerCache[npc] = tracer
    return tracer
end

local function destroyTracer(npc)
    local tracer = tracerCache[npc]
    if tracer then
        tracer.remove()
        tracerCache[npc] = nil
    end
end

local function hideAllTracers()
    for _, tracer in pairs(tracerCache) do
        tracer.update(Vector2.new(0, 0), Vector2.new(0, 0), false)
    end
end

local function clearAllTracers()
    for npc in pairs(tracerCache) do
        destroyTracer(npc)
    end
end

local combatConn = RunService.RenderStepped:Connect(function()
    if antiKillEnabled then
        local character = LocalPlayer.Character
        local rootPart = character and character:FindFirstChild("HumanoidRootPart")
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        if rootPart and humanoid and humanoid.Health > 0 then
            if humanoid.Health > 35 then
                antiKillArmed = true
            elseif antiKillArmed then
                antiKillArmed = false
                rootPart.CFrame = CFrame.new(332, 511, 398)
                rootPart.Velocity = Vector3.zero
                rootPart.AssemblyLinearVelocity = Vector3.zero
            end
        end
    else
        antiKillArmed = true
    end

    local killersFolder = Workspace:FindFirstChild("Killers")
    if not killersFolder then
        if next(espCache) ~= nil then clearAllEsp() end
        if next(tracerCache) ~= nil then clearAllTracers() end
        return
    end

    local currentNpcs = {}
    for _, npc in ipairs(killersFolder:GetChildren()) do
        if npc:IsA("Model") then
            currentNpcs[npc] = true
            local humanoid = npc:FindFirstChildOfClass("Humanoid")
            local alive = (humanoid == nil) or (humanoid.Health > 0)

            if killerEspEnabled then
                ensureEsp(npc, alive)
            end

            if killerTracersEnabled then
                local npcPart = getNpcPart(npc)
                if alive and npcPart then
                    local tracer = ensureTracer(npc)
                    local screenPos, _ = Camera:WorldToViewportPoint(npcPart.Position)
                    local visible = screenPos.Z > 0
                    tracer.update(
                        Vector2.new(Camera.ViewportSize.X * 0.5, Camera.ViewportSize.Y),
                        Vector2.new(screenPos.X, screenPos.Y),
                        visible
                    )
                else
                    local tracer = tracerCache[npc]
                    if tracer then
                        tracer.update(Vector2.new(0, 0), Vector2.new(0, 0), false)
                    end
                end
            else
                local tracer = tracerCache[npc]
                if tracer then
                    tracer.update(Vector2.new(0, 0), Vector2.new(0, 0), false)
                end
            end
        end
    end

    for npc in pairs(espCache) do
        if not currentNpcs[npc] or not npc.Parent then
            destroyEsp(npc)
        end
    end

    for npc in pairs(tracerCache) do
        if not currentNpcs[npc] or not npc.Parent then
            destroyTracer(npc)
        end
    end
end)

